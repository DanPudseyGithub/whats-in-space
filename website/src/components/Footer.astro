---
interface FooterLink {
  _key: string
  label: string
  url: string
}

interface FooterColumn {
  _key: string
  title: string
  links?: FooterLink[]
}

interface Props {
  columns?: FooterColumn[]
  copyrightText?: string
}

const {columns = [], copyrightText} = Astro.props
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__columns">
      {columns.map((column) => (
        <div class="site-footer__column">
          {column.title && <h2 class="site-footer__column-title">{column.title}</h2>}
          <ul>
            {(column.links ?? []).map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    {copyrightText && <p class="site-footer__copyright">{copyrightText}</p>}
  </div>
</footer>

<style>
  .site-footer {
    background: #000;
    padding: 0.875rem;
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 1440px;
    margin-inline: auto;
  }

  .site-footer__columns {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    width: 100%;
  }

  .site-footer__column {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .site-footer__column-title {
    font-size: 0.75rem;
    font-weight: 400;
    color: #8e8e8e;
    margin: 0;
  }

  .site-footer__column ul {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    list-style: none;
    padding: 0;
    font-size: 0.75rem;
  }

  .site-footer__column a {
    color: #fff;
    text-decoration: none;
  }

  .site-footer__copyright {
    font-size: 0.75rem;
    color: #8e8e8e;
    margin: 0;
  }

  @media (min-width: 960px) {
    .site-footer__columns {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      align-items: start;
    }

    .site-footer__column ul {
      gap: 1.25rem;
    }
  }
</style>
